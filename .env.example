# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env
# .env 는 .gitignore에 있어서 깃에 안 올라갑니다 (비밀값 보호).

# Gemini(LLM) API 키 — 필수
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL 비밀번호 (docker-compose가 db/api 양쪽에 넣어줌)
POSTGRES_PASSWORD=1234

# 참고: DATABASE_URL 은 docker-compose.yml이 자동으로 조립해서 넣습니다.
#   내 PC에서 Docker 없이 직접 실행할 땐 env가 없어 database.py의 기본값(localhost)을 씁니다.
